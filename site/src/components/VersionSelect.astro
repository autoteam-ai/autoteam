---
const currentVersion = process.env.AUTOTEAM_DOCS_VERSION || 'next';
const versions = (process.env.AUTOTEAM_DOCS_VERSIONS || currentVersion)
  .split(',')
  .filter(Boolean);
const siteRoot = process.env.AUTOTEAM_DOCS_ROOT || '/';
const currentBase = process.env.AUTOTEAM_DOCS_BASE || '/';
---

<label class="version-select">
  <span class="sr-only">文档版本</span>
  <select
    aria-label="文档版本"
    data-version-select
    data-current-base={currentBase}
    data-site-root={siteRoot}
  >
    {versions.map((version) => (
      <option value={version} selected={version === currentVersion}>
        {version === 'next' ? '开发版（默认）' : `v${version}`}
      </option>
    ))}
  </select>
</label>

<script>
  const select = document.querySelector('[data-version-select]');
  if (select instanceof HTMLSelectElement) {
    select.addEventListener('change', () => {
      const currentBase = select.dataset.currentBase || '/';
      const siteRoot = select.dataset.siteRoot || '/';
      const relativePath = location.pathname.startsWith(currentBase)
        ? location.pathname.slice(currentBase.length)
        : '';
      const targetBase = `${siteRoot}${select.value}/`.replace(/\/+/g, '/');
      location.href = `${targetBase}${relativePath}${location.search}${location.hash}`;
    });
  }
</script>

<style>
  .version-select select {
    max-width: 8rem;
    min-height: 2rem;
    padding: 0.25rem 1.75rem 0.25rem 0.55rem;
    border: 1px solid var(--sl-color-gray-5);
    border-radius: 0.35rem;
    color: var(--sl-color-text);
    background: var(--sl-color-bg-nav);
    font: inherit;
  }

  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }
</style>
