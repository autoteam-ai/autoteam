#!/usr/bin/env bash
# autoteam：把自管理 agent 团队流程（Planner / Implementer / Reviewer / Auditor）装进一个项目。
# 兼容 macOS 自带的 bash 3.2。用法见 `autoteam help`。
set -eo pipefail

# 顺着符号链接找到真实位置：装进 node_modules/.bin/、或本仓库根的 autoteam 开发用
# symlink，都是指向这个文件的链接，BASH_SOURCE[0] 不会自动帮我们解开。
autoteam_src=${BASH_SOURCE[0]}
while [ -L "$autoteam_src" ]; do
  autoteam_dir=$(cd -P "$(dirname "$autoteam_src")" && pwd)
  autoteam_src=$(readlink "$autoteam_src")
  case $autoteam_src in /*) ;; *) autoteam_src=$autoteam_dir/$autoteam_src ;; esac
done
AUTOTEAM_HOME=$(cd -P "$(dirname "$autoteam_src")/.." && pwd)
unset autoteam_src autoteam_dir
AUTOTEAM_LIB=$AUTOTEAM_HOME/lib
# shellcheck disable=SC2034  # 在 lib 里使用
AUTOTEAM_TEMPLATES=$AUTOTEAM_HOME/templates

for autoteam_lib in common conf team render registry instructions lock init upgrade github create_apps multica stop next approve propose doctor setup; do
  # shellcheck source=/dev/null
  . "$AUTOTEAM_LIB/$autoteam_lib.sh"
done
unset autoteam_lib

autoteam_usage() {
  cat <<'EOF'
autoteam —— 把自管理 agent 团队流程装进你的项目

用法：autoteam [-C <目录>] [-P <owner/name>] <命令> [选项]

命令：
  init       生成工作流文件（已有文件不覆盖，受管块只追加一次）
  upgrade    按 .autoteam/.lock.json 升级：没改过的文件直接覆盖，改过的只打印差异
  github     配置 GitHub：仓库设置、规则集、environment、机器账号（默认只预览）
  multica    配置 Multica：旧状态迁移、agent、项目、autopilot、部署 webhook（默认只预览）
  setup      一次预览 GitHub 和 Multica，确认后执行并运行 doctor
  stop       暂停本项目 autopilot 并取消运行（默认只预览）
  resume     恢复停止前 active 的 autopilot（默认只预览）
  status     查看本项目是否暂停（--check 在暂停时返回 1）
  next       列出本项目下一轮巡检要处理的事（只读；--check 有事时返回 1）
  approve    一次放行父任务下所有 backlog 子任务，只叫醒 Planner 一次（默认只预览）
  propose    把你本地的改动用 Implementer App 身份推到新分支并开 PR（默认只预览）
  doctor     逐项检查本地文件、GitHub、Multica 是否到位（只读）
  runtimes   列出 Multica runtime，帮你填 registry.yaml 的 runtime 字段
  diff       对比已安装文件和当前模板
  eject      把包内的角色指令 / autopilot / runbook 复制到 .autoteam/instructions/ 自己维护
  runbook    按名字输出一份 runbook（eject 优先；--list 列出可用的）
  version    打印版本

团队（一个团队仓库服务多个成员仓库，见 design/0003）：
  conf       打印当前项目生效的配置（成员项目 = 团队配置 + 项目配置）

运行时脚本（agent 在任何项目里都这样调，配置按上面的规则取）：
  token            GitHub App 身份：token --run <角色> <命令>、token --setup-git <角色>
  open-pr          开 PR 并按合并模式开自动合并
  merge-mode       判断谁来合并：platform / reviewer / staged / none
  merge-status     核对 PR 的自动合并
  loop-guard       统计任务的打回、验收失败、换人次数
  protected-paths  判断文件是否命中 CODEOWNERS 保护
  deployed-issues  部署清单（deploy <sha>）和是否改了规则文件（rules <sha>）
  metrics          健康指标

通用选项：
  -C <目录>  在指定仓库里执行（默认当前目录）
  -P <owner/name>  指定团队里的项目，不需要在它的 clone 里（也可设 AUTOTEAM_PROJECT）
  -h         查看命令帮助，例如 autoteam github -h

文档：https://github.com/autoteam-ai/autoteam
EOF
}

# shellcheck disable=SC2034  # AUTOTEAM_PROJECT 由 team.sh 的 team_context 读
autoteam_main() {
  local args=() cmd=""
  autoteam_tmp_init
  while [ $# -gt 0 ]; do
    case $1 in
      -C) [ -n "$2" ] || die "-C 需要一个目录"; cd "$2" || die "进不去目录：$2"; shift 2 ;;
      -C*) cd "${1#-C}" || die "进不去目录：${1#-C}"; shift ;;
      -P) [ -n "${2:-}" ] || die "-P 需要 owner/name"; AUTOTEAM_PROJECT=$2; shift 2 ;;
      *)
        if [ -z "$cmd" ]; then cmd=$1; else args+=("$1"); fi
        shift
        # 运行时脚本的参数原样传下去：token --run 后面的命令可能带自己的 -C
        case $cmd in
          token|open-pr|merge-mode|merge-status|loop-guard|protected-paths|deployed-issues|metrics|instruction-budget)
            args+=("$@"); break ;;
        esac ;;
    esac
  done
  case ${cmd:-help} in help|--help|-h|version|--version|-v) ;; *) team_context ;; esac

  case ${cmd:-help} in
    init)     cmd_init ${args[@]+"${args[@]}"} ;;
    github)   cmd_github ${args[@]+"${args[@]}"} ;;
    multica)  cmd_multica ${args[@]+"${args[@]}"} ;;
    setup)    cmd_setup ${args[@]+"${args[@]}"} ;;
    stop)     cmd_stop ${args[@]+"${args[@]}"} ;;
    resume)   cmd_resume ${args[@]+"${args[@]}"} ;;
    status)   cmd_status ${args[@]+"${args[@]}"} ;;
    next)     cmd_next ${args[@]+"${args[@]}"} ;;
    approve)  cmd_approve ${args[@]+"${args[@]}"} ;;
    propose)  cmd_propose ${args[@]+"${args[@]}"} ;;
    doctor)   cmd_doctor ${args[@]+"${args[@]}"} ;;
    runtimes) cmd_runtimes ${args[@]+"${args[@]}"} ;;
    upgrade)  cmd_upgrade ${args[@]+"${args[@]}"} ;;
    diff)     cmd_diff ${args[@]+"${args[@]}"} ;;
    eject)    cmd_eject ${args[@]+"${args[@]}"} ;;
    runbook)  cmd_runbook ${args[@]+"${args[@]}"} ;;
    conf)     cmd_conf ${args[@]+"${args[@]}"} ;;
    token|open-pr|merge-mode|merge-status|loop-guard|protected-paths|deployed-issues|metrics|instruction-budget)
              cmd_script "$cmd" ${args[@]+"${args[@]}"} ;;
    version|--version|-v) echo "autoteam $(autoteam_version)" ;;
    help|--help|-h) autoteam_usage ;;
    *) autoteam_usage >&2; die "未知命令：$cmd" ;;
  esac
}

autoteam_main "$@"
