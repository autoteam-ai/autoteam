{
  "name": "autoteam-workspace",
  "private": true,
  "workspaces": [
    "skills/autoteam",
    "site"
  ],
  "scripts": {
    "test": "bash tests/run.sh",
    "docs:start": "astro dev --root site",
    "docs:build": "astro build --root site && node site/scripts/check-docs-links.mjs",
    "docs:build:all": "node site/scripts/build-docs.mjs",
    "docs:preview": "astro preview --root site"
  }
}
